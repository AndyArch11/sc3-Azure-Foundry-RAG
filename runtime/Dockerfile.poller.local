FROM python:3.12-slim AS deps

WORKDIR /app

ARG RUNTIME_REQUIREMENTS_FILE=/app/runtime-requirements/poller.txt

COPY runtime/requirements/ /app/runtime-requirements/
RUN pip install --no-cache-dir --prefix=/install -r "${RUNTIME_REQUIREMENTS_FILE}"

FROM python:3.12-slim

WORKDIR /app

ENV PATH="/install/bin:${PATH}"
ENV PYTHONPATH="/app:/install/lib/python3.12/site-packages"
ENV CLOUD_PROVIDER=local

COPY --from=deps /install /install

COPY runtime ./runtime
COPY query_web/policies/precedence_policy.json /app/query_web/policies/precedence_policy.json
COPY query_web/policies/precedence_policy.json /app/policies/precedence_policy.json

# Local image includes all providers; no removals

RUN useradd -m -u 1000 appuser
USER appuser

ENTRYPOINT ["python", "-m", "runtime.assessment_orchestration.polling_worker_main"]
