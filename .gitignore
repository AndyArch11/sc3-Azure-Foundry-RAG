# Terraform local state and cache
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan

# Terraform variable overrides / secrets
*.auto.tfvars
*.auto.tfvars.json

# Local env files
.env
.env.*
!.env.local.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.coverage
.coverage.*
htmlcov/

# Local ingestion output — generated by runtime/ingestion/runner.py --mode local
runtime/out/

# OS/editor noise
.DS_Store
.vscode/settings.json
