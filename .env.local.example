# copy this file to .env.local and edit values as needed for local development
CLOUD_PROVIDER=local
LOCAL_VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333

# Local auth (blank = no token required)
QUERY_WEB_AUTH_TOKEN=

# Host port used by query-web in docker-compose.local.yml (change if 8080 is in use)
QUERY_WEB_HOST_PORT=8080

# Local LLM through Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:27b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBED_MAX_CHARS=6000  # Max chars sent per embedding request; halved automatically on context-length errors
# OLLAMA_NUM_CTX=adaptive  # Context window in tokens (default: adaptive by GPU VRAM when available, else host RAM/CPU; approx 4K on constrained hosts up to 128K on high-memory hosts). Adaptive detection probes the local runtime environment; if Ollama is running on a different host (WSL, remote container, etc.) set this explicitly so the context window matches that host's actual resources.

# Precedence policy for framework ordering
PRECEDENCE_POLICY_PATH=/app/query_web/policies/precedence_policy.json

# Ask defaults
# Mode presets: quick | balanced | deep
# Unset individual params to use preset defaults; set them explicitly to override
THINKING_MODE=balanced
# SEARCH_TOP_K=5            # balanced preset: 5
# CONTROLS_TOP_K=4          # balanced preset: 4
# DEFAULT_TEMPERATURE=1.0   # balanced preset: 1.0
# EVALUATOR_TEMPERATURE=1.0 # balanced preset: 1.0
# ACCEPTABLE_SCORE_THRESHOLD=0.72  # balanced preset: 0.72
# MAX_COMPLETION_TOKENS=1400        # Uses computed defaults
# EVALUATOR_MAX_COMPLETION_TOKENS=800  # Uses computed defaults

# Local JSONL-backed indexes inside container
LOCAL_EVIDENCE_JSONL_PATH=/app/runtime/out/chunks.jsonl
LOCAL_CONTROLS_JSONL_PATH=/app/parsed-controls

# Keep validator off for first local bring-up
PROMPT_INJECTION_VALIDATOR_ENABLED=false
PROMPT_INJECTION_VALIDATOR_MODE=off

# Local SQLite-backed state and conversation persistence.
# Optional local Confluence poller settings (required if running confluence-poller locally)
CONFLUENCE_BASE_URL=
CONFLUENCE_AUTH_MODE=basic
CONFLUENCE_AUTH_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_CLOUD_ID=
CONFLUENCE_ACCOUNT_ID=
CONFLUENCE_MENTION_ALIASES=@compliance-agent,@assessment-agent
CONFLUENCE_POLL_SPACE_KEYS=
CONFLUENCE_POLL_INTERVAL_SECONDS=75
CONFLUENCE_POLL_LEASE_TTL_SECONDS=300
CONFLUENCE_POLL_MAX_EVENT_ATTEMPTS=3
CONFLUENCE_POLL_INITIAL_LOOKBACK=PT2H
CONFLUENCE_POLL_DRY_RUN=false

# Local SQLite-backed state and conversation persistence.
# Set LOCAL_STATE_DB_PATH to a file path to enable durable state across restarts.
# Leave unset (or blank) to fall back to ephemeral in-memory state.
# In the Docker Compose stack this maps to the local_state named volume.
LOCAL_STATE_DB_PATH=/app/local_state/state.db

# Required names retained for UI labels and compatibility
AZURE_SEARCH_INDEX_NAME=grounding-index
AZURE_SEARCH_CONTROLS_INDEX_NAME=controls-index
EMBEDDING_DEPLOYMENT_NAME=local-embedding
QUERY_DEPLOYMENT_NAME=ollama
EVALUATOR_DEPLOYMENT_NAME=ollama
