# copy this file to .env.local and edit values as needed for local development
CLOUD_PROVIDER=local
LOCAL_VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333

# Local auth (blank = no token required)
QUERY_WEB_AUTH_TOKEN=

# Local LLM through Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:27b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Precedence policy for framework ordering
PRECEDENCE_POLICY_PATH=/app/query_web/policies/precedence_policy.json

# Ask defaults
SEARCH_TOP_K=5
CONTROLS_TOP_K=4
DEFAULT_TEMPERATURE=0.2
EVALUATOR_TEMPERATURE=0.2
ACCEPTABLE_SCORE_THRESHOLD=0.72
MAX_COMPLETION_TOKENS=1400
EVALUATOR_MAX_COMPLETION_TOKENS=800

# Local JSONL-backed indexes inside container
LOCAL_EVIDENCE_JSONL_PATH=/app/runtime/out/chunks.jsonl
LOCAL_CONTROLS_JSONL_PATH=/app/parsed-controls

# Keep validator off for first local bring-up
PROMPT_INJECTION_VALIDATOR_ENABLED=false
PROMPT_INJECTION_VALIDATOR_MODE=off

# Local SQLite-backed state and conversation persistence.
# Set LOCAL_STATE_DB_PATH to a file path to enable durable state across restarts.
# Leave unset (or blank) to fall back to ephemeral in-memory state.
# In the Docker Compose stack this maps to the local_state named volume.
LOCAL_STATE_DB_PATH=/app/local_state/state.db

# Required names retained for UI labels and compatibility
AZURE_SEARCH_INDEX_NAME=grounding-index
AZURE_SEARCH_CONTROLS_INDEX_NAME=controls-index
EMBEDDING_DEPLOYMENT_NAME=local-embedding
QUERY_DEPLOYMENT_NAME=ollama
EVALUATOR_DEPLOYMENT_NAME=ollama
