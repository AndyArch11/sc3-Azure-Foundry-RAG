{
  "version": 1,
  "schemas": {
    "eval_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "expected_skill"],
      "properties": {
        "id": {"type": "string"},
        "prompt": {"type": "string"},
        "expected_skill": {"type": "string"}
      }
    },
    "eval_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "description", "cases"],
      "properties": {
        "version": {"const": 1},
        "description": {"type": "string"},
        "cases": {
          "type": "array",
          "items": {"$ref": "#/schemas/eval_case"}
        }
      }
    },
    "eval_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "expected_skill", "selected_skill", "match"],
      "properties": {
        "case_id": {"type": "string"},
        "expected_skill": {"type": "string"},
        "selected_skill": {"type": "string"},
        "match": {"type": "boolean"}
      }
    },
    "skill_doc_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "outputs",
        "allowed_identity_modes",
        "failure_modes",
        "audit_fields"
      ],
      "properties": {
        "name": {"type": "string"},
        "outputs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "allowed_identity_modes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "failure_modes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "audit_fields": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
