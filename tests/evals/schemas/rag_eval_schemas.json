{
  "version": 1,
  "schemas": {
    "rag_eval_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "retrieve_k",
        "expected_relevant_frameworks"
      ],
      "properties": {
        "id": {"type": "string"},
        "question": {"type": "string"},
        "retrieve_k": {"type": "integer", "minimum": 1, "maximum": 50},
        "expected_relevant_frameworks": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "min_precision": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "min_diversity": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_dominant_framework_share": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "controls_framework": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      }
    },
    "rag_eval_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "description", "cases"],
      "properties": {
        "version": {"const": 1},
        "description": {"type": "string"},
        "cases": {
          "type": "array",
          "items": {"$ref": "#/schemas/rag_eval_case"}
        }
      }
    }
  }
}
